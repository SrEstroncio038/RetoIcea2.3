                  </VBox>
                  <VBox spacing="2.0">
                     <children>
                        <Label text="Expire date:" />
                        <TextField fx:id="txtExpireDate" maxWidth="1.7976931348623157E308" />
                     </children>
                  </VBox>
                  <VBox spacing="2.0">
                     <children>
                        <Label text="CVV:" />
                        <TextField fx:id="txtCvv" maxWidth="1.7976931348623157E308" />
                     </children>
                  </VBox>
                  <Button fx:id="btnConfirmPurchase" mnemonicParsing="false"  prefHeight="31.0" prefWidth="140.0" style="-fx-background-color: #2B4C94; -fx-text-fill: white; -fx-background-radius: 6;" text="Confirm Purchase" />
               </children>
            </VBox>
