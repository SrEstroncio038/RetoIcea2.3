<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="294.0" minWidth="404.0" prefHeight="294.0" prefWidth="404.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.retoicea2_3.Controller.ConfirmPurchase">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="37.0" style="-fx-background-color: D4E1F5;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="8.0" right="8.0" />
         </padding>
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false"  style="-fx-background-color: D4E1F5;" text="Home" textFill="#004c99" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <VBox spacing="5.0" HBox.hgrow="SOMETIMES" minWidth="120.0" prefWidth="145.0">
               <children>
                  <Label text="Cart:" />
                  <ListView fx:id="lvCart" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="8.0" HBox.hgrow="ALWAYS" minWidth="180.0" prefWidth="200.0">
