<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="260.0" minWidth="320.0" prefHeight="320.0" prefWidth="467.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.retoicea2_3.Controller.ManageWorkersController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: D4E1F5;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="12.0" right="12.0" />
         </padding>
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: D4E1F5; -fx-font-size: 14px;" text="Home" textFill="#004c99" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="35.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Manage Workers" textFill="#2B4C94">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="btnToSignUp" mnemonicParsing="false" prefHeight="28.0" prefWidth="120.0" style="-fx-background-color: #2B4C94; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6;" text="To Sign Up" />
            <Button fx:id="btnToRemove" mnemonicParsing="false" prefHeight="28.0" prefWidth="120.0" style="-fx-background-color: #2B4C94; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6;" text="To Remove" />
            <Button fx:id="btnModify" mnemonicParsing="false" prefHeight="28.0" prefWidth="120.0" style="-fx-background-color: #2B4C94; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6;" text="Modify" />
         </children>
      </VBox>
   </center>
</BorderPane>