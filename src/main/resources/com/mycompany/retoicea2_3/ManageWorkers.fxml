<BorderPane minHeight="260.0" minWidth="320.0" prefHeight="373.0" prefWidth="467.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.retoicea2_3.Controller.ManageWorkersController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: D4E1F5;" BorderPane.alignment="CENTER">
