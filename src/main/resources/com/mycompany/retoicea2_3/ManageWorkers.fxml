            <Button fx:id="btnToRemove" layoutX="307.0" layoutY="10.0" mnemonicParsing="false" onAction="#remove" prefHeight="28.0" prefWidth="120.0" style="-fx-background-color: #2B4C94; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6;" text="To Remove" />
